# Keep legacy static-page URLs routed to the PHP-backed pages, including when
# this project is installed inside a subdirectory such as /portfolio/.
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(index|about|skills|projects|resume|contact)\.html$ $1.php [R=301,L,NC]
</IfModule>

# Protect configuration, SQL exports, and repository metadata from web access.
<FilesMatch "^(\.git|\.env|composer\.(json|lock)|.*\.sql)$">
    Require all denied
</FilesMatch>
