# Keep legacy static-page URLs redirecting to PHP while protecting uploaded files.
Redirect 301 /projects.html /projects.php
Redirect 301 /skills.html /skills.php
Redirect 301 /about.html /about.php
Redirect 301 /resume.html /resume.php
Redirect 301 /contact.html /contact.php
Redirect 301 /index.html /index.php

# Prevent direct PHP execution and script uploads inside upload directories.
<DirectoryMatch "^(.*/)?uploads(/.*)?$">
    <FilesMatch "\.(php|phtml|phar|pl|py|cgi|sh)$">
        Require all denied
    </FilesMatch>
</DirectoryMatch>
